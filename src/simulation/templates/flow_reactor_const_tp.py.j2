import cantera as ct
import numpy as np

# ── Mechanism ─────────────────────────────────────────────────────────
mechanism_file = '{{ mechanism | default("mechanism.yaml") }}'

# ── Conditions ────────────────────────────────────────────────────────
composition = '{{ composition_str }}'
temperature_K = {{ temperature_min }}
pressure_Pa = {{ pressure_min }}
residence_time_s = {{ residence_time | default(end_time | default(1.0)) }}

# ── Isothermal constant-P reactor (PFR approximation) ────────────────
gas = ct.Solution(mechanism_file)
gas.TPX = temperature_K, pressure_Pa, composition
reactor = ct.IdealGasConstPressureReactor(gas, energy='off', clone=True)
sim = ct.ReactorNet([reactor])
sim.atol = 1e-16
sim.rtol = 1e-8

# ── Integration along residence time ─────────────────────────────────
n_steps = 200
dt = residence_time_s / n_steps
times = [0.0]
{% if composition_species %}
species_data = { {% for sp in composition_species %}'{{ sp }}': [gas['{{ sp }}'].X[0]], {% endfor %} }
{% endif %}

for i in range(1, n_steps + 1):
    sim.advance(i * dt)
    times.append(sim.time)
{% if composition_species %}
{% for sp in composition_species %}
    species_data['{{ sp }}'].append(reactor.phase['{{ sp }}'].X[0])
{% endfor %}
{% endif %}

# ── Output ────────────────────────────────────────────────────────────
{% for obs in target_observables %}
# Target observable: {{ obs }}
{% endfor %}
times = np.array(times)
print(f'Flow reactor: {n_steps} steps over {residence_time_s*1e3:.1f} ms')
{% if composition_species %}
{% for sp in composition_species %}
print(f'{{ sp }}: initial={species_data["{{ sp }}"][0]:.6e}, final={species_data["{{ sp }}"][-1]:.6e}')
{% endfor %}
{% endif %}

"""Shock tube ignition delay simulation (constant-UV, adiabatic).

Scenario: {{ scenario_id }}
Family:   {{ experiment_family }} ({{ template_family }})

Generated by the simulator agent. Review conditions before running.
Mirrors core/runner.py::_run_shock_tube — do not diverge.
"""

import cantera as ct
import numpy as np

# ── Mechanism ─────────────────────────────────────────────────────────
mechanism_file = '{{ mechanism | default("mechanism.yaml") }}'

# ── Conditions ────────────────────────────────────────────────────────
composition = '{{ composition_str }}'
{% if temperature_mode == "range" %}
temperatures_K = np.linspace({{ temperature_min }}, {{ temperature_max }}, {{ n_temperatures | default(10) }})
{% else %}
temperatures_K = [{{ temperature_min }}]
{% endif %}
pressure_Pa = {{ pressure_min }}
end_time = {{ end_time | default(1.0) }}

# ── Simulation ────────────────────────────────────────────────────────
results = []
for T in temperatures_K:
    gas = ct.Solution(mechanism_file)
    gas.TPX = T, pressure_Pa, composition
    reactor = ct.IdealGasReactor(gas, clone=True)
    sim = ct.ReactorNet([reactor])
    sim.atol = 1e-16
    sim.rtol = 1e-8

    times, temps = [0.0], [reactor.T]
    while sim.time < end_time:
        sim.step()
        times.append(sim.time)
        temps.append(reactor.T)

    times = np.array(times)
    temps = np.array(temps)

    # Ignition delay: time of max dT/dt
    dtdt = np.diff(temps) / np.diff(times)
    idt_idx = int(np.argmax(dtdt))
    idt = times[idt_idx + 1]

    T_rise = temps.max() - temps[0]
    if T_rise < 0.02 * temps[0]:
        idt = times[-1]  # no ignition within window

    results.append({'T_K': T, 'P_Pa': pressure_Pa, 'idt_s': idt, 'T_rise_K': T_rise})

# ── Output ────────────────────────────────────────────────────────────
{% for obs in target_observables %}
# Target observable: {{ obs }}
{% endfor %}
print(f'Completed {len(temperatures_K)} condition(s)')
for r in results:
    print(f"  T={r['T_K']:.0f} K, IDT={r['idt_s']*1e6:.1f} us, T_rise={r['T_rise_K']:.0f} K")

"""Freely propagating premixed flame simulation.

Scenario: {{ scenario_id }}
Family:   {{ experiment_family }} ({{ template_family }})

Generated by the simulator agent. Review conditions before running.
Mirrors core/runner.py::_run_flame — do not diverge.
"""

import cantera as ct

# ── Mechanism ─────────────────────────────────────────────────────────
mechanism_file = '{{ mechanism | default("mechanism.yaml") }}'

# ── Conditions ────────────────────────────────────────────────────────
composition = '{{ composition_str }}'
temperature_K = {{ temperature_min }}
pressure_Pa = {{ pressure_min }}

# ── Flame setup ──────────────────────────────────────────────────────
gas = ct.Solution(mechanism_file)
gas.TPX = temperature_K, pressure_Pa, composition

width = 0.03  # m
flame = ct.FreeFlame(gas, width=width)
flame.set_refine_criteria(ratio=3, slope=0.07, curve=0.14)
flame.solve(loglevel=0, auto=True)

# ── Output ────────────────────────────────────────────────────────────
flame_speed = flame.velocity[0]
T_burnt = flame.T[-1]
print(f'Flame speed: {flame_speed:.4f} m/s')
print(f'T_burnt: {T_burnt:.0f} K')
print(f'Grid points: {len(flame.grid)}')

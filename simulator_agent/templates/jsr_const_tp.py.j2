"""Jet-stirred reactor simulation (constant T, P, steady-state).

Scenario: {{ scenario_id }}
Family:   {{ experiment_family }} ({{ template_family }})

Generated by the simulator agent. Review conditions before running.
Mirrors core/runner.py::_run_jsr — do not diverge.
"""

import cantera as ct

# ── Mechanism ─────────────────────────────────────────────────────────
mechanism_file = '{{ mechanism | default("mechanism.yaml") }}'

# ── Conditions ────────────────────────────────────────────────────────
composition = '{{ composition_str }}'
temperature_K = {{ temperature_min }}
pressure_Pa = {{ pressure_min }}
residence_time_s = {{ residence_time | default(1.0) }}

# ── Reactor network ──────────────────────────────────────────────────
# Inlet reservoir (fresh feed)
inlet_gas = ct.Solution(mechanism_file)
inlet_gas.TPX = temperature_K, pressure_Pa, composition
upstream = ct.Reservoir(inlet_gas, clone=True)

# Exhaust reservoir
exhaust_gas = ct.Solution(mechanism_file)
exhaust_gas.TPX = temperature_K, pressure_Pa, composition
downstream = ct.Reservoir(exhaust_gas, clone=True)

# Isothermal CSTR (energy='off' holds temperature constant)
gas = ct.Solution(mechanism_file)
gas.TPX = temperature_K, pressure_Pa, composition
reactor = ct.IdealGasReactor(gas, energy='off', clone=True)

# Flow controllers
volume = reactor.volume
mass_flow = inlet_gas.density * volume / residence_time_s
mfc = ct.MassFlowController(upstream, reactor, mdot=mass_flow)
ct.PressureController(reactor, downstream, primary=mfc, K=1e-3)

# ── Integration to steady state ──────────────────────────────────────
sim = ct.ReactorNet([reactor])
sim.atol = 1e-16
sim.rtol = 1e-8
sim.advance(residence_time_s * 50)  # ~50 residence times

# ── Output ────────────────────────────────────────────────────────────
{% for obs in target_observables %}
# Target observable: {{ obs }}
{% endfor %}
print(f'Steady state at t={sim.time:.2f} s ({sim.time/residence_time_s:.0f} tau)')
print(f'T = {reactor.T:.1f} K, P = {reactor.phase.P:.0f} Pa')
{% if composition_species %}
{% for sp in composition_species %}
print(f'{{ sp }}: {reactor.phase["{{ sp }}"].X[0]:.6e}')
{% endfor %}
{% endif %}
